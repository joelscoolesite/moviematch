rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isRoomMember(roomId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberIds;
    }

    // ---------------------------------------------------------------
    // users/{uid} — privéprofiel incl. voorkeuren. Alleen de eigenaar
    // mag lezen/schrijven. Andere gebruikers zien nooit elkaars
    // preferences/e-mail rechtstreeks (roomleden gebruiken de publieke
    // "members" subcollectie van een room in plaats daarvan).
    // ---------------------------------------------------------------
    match /users/{uid} {
      allow read, update: if isOwner(uid);
      allow create: if isOwner(uid);
      allow delete: if false;

      match /swipes/{movieId} {
        allow read, write: if isOwner(uid);
      }

      match /watchlist/{movieId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ---------------------------------------------------------------
    // movies/{movieId} — gedeelde, publieke TMDB-cache. Geen
    // gevoelige data, dus elke ingelogde gebruiker mag lezen en de
    // cache aanvullen/verversen. Geen deletes vanuit de client.
    // ---------------------------------------------------------------
    match /movies/{movieId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // rooms/{roomId}
    // ---------------------------------------------------------------
    match /rooms/{roomId} {
      // Elke ingelogde gebruiker mag een room-document proberen te lezen.
      // Dit is nodig om (a) te checken of een room-code al bestaat bij het
      // aanmaken, en (b) een room te vinden om te joinen voordat je zelf al
      // in memberIds staat. Gevoelige data (swipes, leden-details) staat in
      // submappen die wél alleen voor leden toegankelijk zijn.
      allow read: if isSignedIn();

      // Aanmaken: alleen als de maker zichzelf meteen als enige member zet.
      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.memberIds.size() == 1 &&
        request.resource.data.memberIds[0] == request.auth.uid;

      // Updaten mag als je al lid bent (bv. naam wijzigen), of als de
      // update precies bestaat uit het toevoegen van jezelf (joinen).
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.memberIds ||
        (
          request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1 &&
          request.resource.data.memberIds.hasAll(resource.data.memberIds) &&
          request.auth.uid in request.resource.data.memberIds
        )
      );

      allow delete: if false;

      match /members/{memberUid} {
        allow read: if isRoomMember(roomId);
        allow create: if isSignedIn() && request.auth.uid == memberUid;
        allow update: if isOwner(memberUid);
        allow delete: if false;
      }

      match /swipes/{movieId} {
        allow read: if isRoomMember(roomId);
        allow create, update: if isRoomMember(roomId);
        allow delete: if false;
      }

      match /userSwipes/{memberUid} {
        allow read: if isRoomMember(roomId);
        allow create, update: if isOwner(memberUid) && isRoomMember(roomId);
        allow delete: if false;
      }
    }
  }
}
